TOOL_LLM_URL=http://127.0.0.1:11435/v1
API_KEY=ollama
MANAGER_MODEL=gpt-oss:20b
SUBAGENT_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=180
A2A_TIMEOUT_SECONDS=900
MANAGER_MAX_TURNS=16
MANAGER_TIMEOUT_SECONDS=600

MANAGER_URL=http://10.218.101.248:10000/
DRONE_URL=http://10.218.101.248:10001/
ROVER_URL=http://10.218.101.248:10002/
FORKLIFT_URL=http://127.0.0.1:10003/
# Optional comma-separated list of agent addresses. Only addresses are configured;
# the manager learns capabilities by fetching the cards over A2A.
# AGENT_URLS=http://10.218.101.248:10001/,http://10.218.101.248:10002/,http://127.0.0.1:10003/

# IoTAuth uses the sibling iotauth/entity/node/example_entities by default.
# IOTAUTH_ENTITY_DIR=/absolute/path/to/iotauth/entity/node/example_entities
IOTAUTH_MANAGER_CONFIG=configs/net1/managerAgent.config
IOTAUTH_NODE=node
IOTAUTH_TIMEOUT_SECONDS=30

# Map all A2A endpoints to their IoTAuth groups; keep URLs aligned with *_URL.
# Manager is included for completeness; the default worker roster excludes it.
IOTAUTH_AGENT_GROUPS='{"http://10.218.101.248:10000/":"ManagerAgents","http://10.218.101.248:10001/":"DroneAgents","http://10.218.101.248:10002/":"RoverAgents","http://127.0.0.1:10003/":"ForkliftAgents"}'

IOTAUTH_FORKLIFT_CONFIG=configs/net1/forkliftAgent.config
IOTAUTH_FORKLIFT_RESOURCE=net1.resource

# Camera-guided ROS2 grasp: calibrate the profile before enabling.
FORKLIFT_GRASP_ENABLED=false
# FORKLIFT_GRASP_CONFIG=/home/jetson/camera_grasp.json
FORKLIFT_ROS_PYTHON=/usr/bin/python3

# Discovery endpoints must already be running (local or remote).
# AGENT_URLS is independent of which processes this machine launches.
# JSON list; omit remote workers. Manager-only default if this setting is absent.
LOCAL_AGENT_MODULES='["agents.drone_agent","agents.rover_agent","agents.forklift_agent","agents.manager_agent"]'

# Resource catalog from the GUI's saved graph. Relative to a2a-multi-agent.
# Select the same graph used to provision Auth; re-save it to update future requests.
IOTAUTH_GRAPH_FILE=../iotauth/examples/configs/my_agents.graph
IOTAUTH_MANAGER_ENTITY=net1.managerAgent
