TOOL_LLM_URL=http://127.0.0.1:11435/v1
API_KEY=ollama
MANAGER_MODEL=gpt-oss:20b
SUBAGENT_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=180
A2A_TIMEOUT_SECONDS=900
MANAGER_MAX_TURNS=16
MANAGER_TIMEOUT_SECONDS=600

MANAGER_URL=http://127.0.0.1:10000/
DRONE_URL=http://127.0.0.1:10001/
ROVER_URL=http://127.0.0.1:10002/
FORKLIFT_URL=http://127.0.0.1:10003/
LOCAL_AGENT_MODULES='["agents.manager_agent","agents.drone_agent","agents.rover_agent","agents.forklift_agent"]'

# IOTAUTH_ENTITY_DIR=/absolute/path/to/iotauth/entity/node/example_entities
IOTAUTH_MANAGER_CONFIG=configs/net1/managerAgent.config
IOTAUTH_DRONE_CONFIG=configs/net1/droneAgent.config
IOTAUTH_ROVER_CONFIG=configs/net1/roverAgent.config
IOTAUTH_FORKLIFT_CONFIG=configs/net1/forkliftAgent.config
IOTAUTH_NODE=node
IOTAUTH_TIMEOUT_SECONDS=30

# Discovery uses these addresses, excluding MANAGER_URL.
# Optional AGENT_URLS can restrict discovery to a subset.
IOTAUTH_AGENT_GROUPS='{"http://127.0.0.1:10000/":"ManagerAgent","http://127.0.0.1:10001/":"DroneAgent","http://127.0.0.1:10002/":"RoverAgent","http://127.0.0.1:10003/":"ForkliftAgent"}'
IOTAUTH_GRAPH_FILE=../iotauth/examples/configs/my_agents.graph
IOTAUTH_MANAGER_ENTITY=net1.managerAgent

IOTAUTH_ITEM_GROUP=TargetItem
IOTAUTH_GATE_GROUP=Gate
# Enable after starting the Mac simulator and SSH tunnel.
GAZEBO_DELIVERY_URL=http://127.0.0.1:21200
